{
  "$comment": "A Lips component stylesheet. Mirrors scan / readValue / readInterpolation in src/ir/style.ts of @lipsjs/lips: declarations may sit at the top level (they style the component's root), rules nest, '//' opens a comment only where a statement starts, and '{expr}' is an expression only inside a declaration value, optionally followed by a unit. Every begin/end rule also ends at an unescaped backtick.",
  "name": "Lips stylesheet",
  "scopeName": "source.css.lips",
  "patterns": [
    { "include": "#rule-list" }
  ],
  "repository": {
    "rule-list": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#line-comment" },
        { "include": "#at-rule" },
        { "include": "#declaration" },
        { "include": "#block" },
        { "include": "#selector" }
      ]
    },

    "comment": {
      "name": "comment.block.css",
      "begin": "/\\*",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.css" } },
      "end": "\\*/|(?=(?<!\\\\)`)",
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.css" } }
    },

    "line-comment": {
      "$comment": "scan: '//' where a statement starts is a comment (Stylis syntax); inside a value it is not (--api: https://x)",
      "name": "comment.line.double-slash.lips",
      "match": "//.*?(?=(?<!\\\\)`|$)"
    },

    "at-rule": {
      "name": "meta.at-rule.css",
      "begin": "((@)[A-Za-z-]+)",
      "beginCaptures": {
        "1": { "name": "keyword.control.at-rule.css" },
        "2": { "name": "punctuation.definition.keyword.css" }
      },
      "end": "(;)|(?=[{}])|(?=(?<!\\\\)`)",
      "endCaptures": { "1": { "name": "punctuation.terminator.rule.css" } },
      "patterns": [
        { "include": "#comment" },
        {
          "name": "variable.parameter.keyframe-list.css",
          "match": "(?<=@keyframes\\s)\\s*-?[A-Za-z_][\\w-]*"
        },
        {
          "name": "meta.feature.css",
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.definition.parameters.begin.bracket.round.css" } },
          "end": "\\)|(?=(?<!\\\\)`)",
          "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.bracket.round.css" } },
          "patterns": [
            {
              "match": "(-?[A-Za-z_][\\w-]*)\\s*(:)",
              "captures": {
                "1": { "name": "support.type.property-name.media.css" },
                "2": { "name": "punctuation.separator.key-value.css" }
              }
            },
            { "include": "#value" }
          ]
        },
        { "name": "keyword.operator.logical.css", "match": "(?<![\\w-])(?:and|not|only|or)(?![\\w-])" },
        { "include": "#string" },
        { "include": "#number" },
        { "name": "support.constant.media.css", "match": "-?[A-Za-z_][\\w-]*" },
        { "name": "punctuation.separator.list.comma.css", "match": "," }
      ]
    },

    "declaration": {
      "$comment": "readValue / readInterpolation: 'name:' is a declaration when what follows, up to ';' '}' or the line's end, holds no block — a '{…}' there must be expression-shaped (not empty, no ';' or '{', no ':' unless a '?' came first). So 'a:hover { … }' is a selector.",
      "name": "meta.property-list.declaration.css",
      "begin": "(?:(--[\\w-]+)|(-?[A-Za-z_][\\w-]*))\\s*(:)(?=(?:[^;{}`]|\\{(?=\\s*[^\\s}])[^{};?:`]*(?:\\?[^{};`]*)?\\})*(?:[;}`]|$))",
      "beginCaptures": {
        "1": { "name": "variable.css" },
        "2": { "name": "support.type.property-name.css" },
        "3": { "name": "punctuation.separator.key-value.css" }
      },
      "end": "(;)|(?=\\})|(?=(?<!\\\\)`)",
      "endCaptures": { "1": { "name": "punctuation.terminator.rule.css" } },
      "contentName": "meta.property-value.css",
      "patterns": [ { "include": "#value" } ]
    },

    "block": {
      "name": "meta.property-list.css",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.property-list.begin.bracket.curly.css" } },
      "end": "\\}|(?=(?<!\\\\)`)",
      "endCaptures": { "0": { "name": "punctuation.section.property-list.end.bracket.curly.css" } },
      "patterns": [ { "include": "#rule-list" } ]
    },

    "selector": {
      "patterns": [
        { "name": "entity.name.tag.nesting.css", "match": "&" },
        {
          "name": "entity.other.attribute-name.class.css",
          "match": "(\\.)-?[A-Za-z_][\\w-]*",
          "captures": { "1": { "name": "punctuation.definition.entity.css" } }
        },
        {
          "name": "entity.other.attribute-name.id.css",
          "match": "(#)-?[A-Za-z_][\\w-]*",
          "captures": { "1": { "name": "punctuation.definition.entity.css" } }
        },
        {
          "name": "entity.other.attribute-name.pseudo-element.css",
          "match": "(::)[\\w-]+",
          "captures": { "1": { "name": "punctuation.definition.entity.css" } }
        },
        {
          "name": "entity.other.attribute-name.pseudo-class.css",
          "match": "(:)[\\w-]+",
          "captures": { "1": { "name": "punctuation.definition.entity.css" } }
        },
        {
          "name": "meta.attribute-selector.css",
          "begin": "\\[",
          "beginCaptures": { "0": { "name": "punctuation.definition.entity.begin.bracket.square.css" } },
          "end": "\\]|(?=(?<!\\\\)`)",
          "endCaptures": { "0": { "name": "punctuation.definition.entity.end.bracket.square.css" } },
          "patterns": [
            { "include": "#string" },
            { "name": "keyword.operator.pattern.css", "match": "[~|^$*]?=" },
            { "name": "entity.other.attribute-name.css", "match": "-?[A-Za-z_][\\w-]*" }
          ]
        },
        { "name": "entity.other.keyframe-offset.percentage.css", "match": "(?<![\\w-])\\d+(?:\\.\\d+)?%" },
        { "name": "entity.other.keyframe-offset.css", "match": "(?<![\\w.#:-])(?:from|to)(?![\\w-])" },
        { "name": "entity.name.tag.wildcard.css", "match": "\\*" },
        { "name": "keyword.operator.combinator.css", "match": "[>+~]" },
        { "name": "punctuation.separator.list.comma.css", "match": "," },
        { "name": "entity.name.tag.css", "match": "(?<![\\w.#:-])-?[A-Za-z_][\\w-]*" }
      ]
    },

    "value": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#interpolation" },
        { "include": "#string" },
        { "name": "keyword.other.important.css", "match": "!\\s*important(?![\\w-])" },
        {
          "name": "constant.other.color.rgb-value.hex.css",
          "match": "(#)\\h{3,8}(?![\\w-])",
          "captures": { "1": { "name": "punctuation.definition.constant.css" } }
        },
        { "include": "#number" },
        {
          "name": "meta.function.css",
          "begin": "(-?[A-Za-z_][\\w-]*)(\\()",
          "beginCaptures": {
            "1": { "name": "support.function.css" },
            "2": { "name": "punctuation.section.function.begin.bracket.round.css" }
          },
          "end": "\\)|(?=(?<!\\\\)`)",
          "endCaptures": { "0": { "name": "punctuation.section.function.end.bracket.round.css" } },
          "patterns": [ { "include": "#value" } ]
        },
        { "name": "variable.argument.css", "match": "--[\\w-]+" },
        { "name": "support.constant.property-value.css", "match": "-?[A-Za-z_][\\w-]*" },
        { "name": "punctuation.separator.list.comma.css", "match": "," },
        { "name": "keyword.operator.css", "match": "[*/+-]" }
      ]
    },

    "interpolation": {
      "$comment": "readValue: '{expr}' in a value, then a unit suffix ('{…}%', '{…}px') that compiles to calc(var(--x) * 1unit)",
      "patterns": [
        {
          "name": "meta.embedded.expression.lips",
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.lips" } },
          "end": "\\}|(?=(?<!\\\\)`)",
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.lips" } },
          "patterns": [ { "include": "source.ts#expression" } ]
        },
        { "name": "keyword.other.unit.css", "match": "(?<=\\})(?:%|[A-Za-z]+)" }
      ]
    },

    "number": {
      "match": "(?<![\\w-])[-+]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][-+]?\\d+)?(%|[A-Za-z]+)?",
      "name": "constant.numeric.css",
      "captures": { "1": { "name": "keyword.other.unit.css" } }
    },

    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.css",
          "begin": "\"",
          "end": "\"|$|(?=(?<!\\\\)`)",
          "patterns": [ { "name": "constant.character.escape.css", "match": "\\\\." } ]
        },
        {
          "name": "string.quoted.single.css",
          "begin": "'",
          "end": "'|$|(?=(?<!\\\\)`)",
          "patterns": [ { "name": "constant.character.escape.css", "match": "\\\\." } ]
        }
      ]
    }
  }
}
