{
  "name": "lips",
  "displayName": "lips-language",
  "description": "Lips markup syntax highlighter",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lips",
        "aliases": ["Lips", "lips"],
        "extensions": [],
        "configuration": "./language-configuration.json",
        "embeddedLanguages": {
          "meta.embedded.inline.html": "html"
        }
      }
    ],
    "grammars": [
      {
        "language": "lips",
        "scopeName": "source.lips",
        "path": "./syntaxes/lips.tmLanguage.json"
      },
      {
        "injectTo": ["source.ts", "source.js"],
        "scopeName": "lips.template.injection",
        "path": "./syntaxes/lips-injection.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/lips-js/syntax-highligther"
  }
}