{
  "name": "Lips",
  "scopeName": "source.lips",
  "patterns": [
    { "include": "#expression" },
    { "include": "#tag" },
    { "include": "#comment" },
    { "include": "#entity" },
    { "include": "#string" }
  ],
  "repository": {
    "expression": {
      "begin": "{",
      "end": "}",
      "name": "meta.embedded.expression.lips",
      "patterns": [
        { "include": "source.ts" }
      ]
    },
    "tag": {
      "begin": "(<)([a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.lips" },
        "2": { "name": "entity.name.tag.lips" }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.lips" }
      },
      "name": "meta.tag.lips",
      "patterns": [
        { "include": "#tag-attributes" },
        { "include": "#expression" }
      ]
    },
    "tag-attributes": {
      "patterns": [
        {
          "match": "([a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*)\\s*(=)\\s*",
          "name": "meta.attribute-with-value.lips",
          "captures": {
            "1": { "name": "entity.other.attribute-name.lips" },
            "3": { "name": "punctuation.separator.key-value.lips" }
          }
        },
        {
          "match": "(:)([a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*)",
          "name": "meta.directive.lips",
          "captures": {
            "1": { "name": "punctuation.definition.directive.lips" },
            "2": { "name": "entity.other.attribute-name.directive.lips" }
          }
        },
        {
          "match": "(\\[)([^\\]]+)(\\])",
          "name": "meta.arguments.lips",
          "captures": {
            "1": { "name": "punctuation.definition.arguments.begin.lips" },
            "2": { "name": "variable.parameter.lips" },
            "3": { "name": "punctuation.definition.arguments.end.lips" }
          }
        },
        {
          "match": "(on-[a-zA-Z-]+)",
          "name": "entity.other.attribute-name.event.lips",
          "captures": {
            "1": { "name": "entity.other.attribute-name.event-handler.lips" }
          }
        },
        {
          "match": "(i18n)",
          "name": "entity.other.attribute-name.i18n.lips"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.lips"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.lips"
        }
      ]
    },
    "comment": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.lips"
    },
    "entity": {
      "match": "&([a-zA-Z0-9]+|#[0-9]+|#x[0-9a-fA-F]+);",
      "name": "constant.character.entity.lips"
    },
    "string": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.lips"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.lips"
        }
      ]
    }
  }
}