{
  "scopeName": "lips.template.injection",
  "injectionSelector": "L:source.ts, L:source.js",
  "patterns": [
    {
      "include": "#lips-template-object-property"
    },
    {
      "include": "#lips-template-default-export"
    }
  ],
  "repository": {
    "lips-template-object-property": {
      "begin": "(default)\\s*:\\s*(`)",
      "beginCaptures": {
        "1": { "name": "keyword.other.lips" },
        "2": { "name": "punctuation.definition.string.template.begin.js" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.js" }
      },
      "contentName": "meta.embedded.block.lips",
      "patterns": [
        { "include": "source.lips" }
      ]
    },
    "lips-template-default-export": {
      "begin": "(export)\\s+(default)\\s+(`)",
      "beginCaptures": {
        "1": { "name": "keyword.control.export.js" },
        "2": { "name": "keyword.control.default.js" },
        "3": { "name": "punctuation.definition.string.template.begin.js" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.js" }
      },
      "contentName": "meta.embedded.block.lips",
      "patterns": [
        { "include": "source.lips" }
      ]
    }
  }
}